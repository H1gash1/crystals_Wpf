<Page x:Class="crystals_Wpf.Pages.AchievementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:crystals_Wpf.Pages">

    <Page.Resources>
        <local:UnlockedToStyleConverter x:Key="UnlockedToStyle"/>
        <local:BoolToTextColorConverter x:Key="TextColorConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibility"/>

        <DataTemplate x:Key="AchievementTemplate">
            <Border Style="{Binding IsUnlocked, Converter={StaticResource UnlockedToStyle}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Иконка достижения -->
                    <Border Width="50" Height="50" 
                            CornerRadius="25" 
                            Margin="0,0,15,0"
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Background="#FF6B6B">
                        <TextBlock Text="{Binding Icon}" 
                                   FontSize="28" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Информация -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="{Binding IsUnlocked, Converter={StaticResource TextColorConverter}}"/>
                        <TextBlock Text="{Binding Description}" 
                                   FontSize="13" 
                                   Foreground="#666666"
                                   Margin="0,3,0,0"/>

                        <TextBlock Text="{Binding UnlockDate}" 
                                   FontSize="11" 
                                   Foreground="#4ECDC4"
                                   Margin="0,5,0,0"
                                   Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="🔒 НЕ ПОЛУЧЕНО" 
                                   FontSize="11" 
                                   Foreground="#FF6B6B"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"
                                   Visibility="{Binding IsUnlocked, Converter={StaticResource InvertBoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/crystals_Wpf;component/assets/bg.png" 
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Background="#80FFFFFF" Margin="20" CornerRadius="20">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Margin="0,0,0,20" Padding="20,12" CornerRadius="10" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF6B6B" Offset="0"/>
                            <GradientStop Color="#FF8E53" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🏅 ДОСТИЖЕНИЯ 🏅" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <!-- Список достижений -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AchievementsGrid"
                                  ItemTemplate="{StaticResource AchievementTemplate}"/>
                </ScrollViewer>

                <!-- Кнопка назад -->
                <Button Grid.Row="2"
                        Content="← НАЗАД"
                        Width="150"
                        Height="40"
                        Margin="0,20,0,0"
                        Background="#FF6B6B"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BackButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>