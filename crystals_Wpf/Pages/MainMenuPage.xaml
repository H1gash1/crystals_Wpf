<Page x:Class="crystals_Wpf.Pages.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/crystals_Wpf;component/assets/bg.png" 
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Background="#40FFFFFF" Margin="30" CornerRadius="20">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Приветствие с градиентом -->
                    <Border Margin="0,0,0,40" Padding="20,15" CornerRadius="15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6B6B" Offset="0"/>
                                <GradientStop Color="#FF8E53" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="WelcomeText"
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Кнопки меню -->
                    <Button Style="{StaticResource MenuButton}" 
                            Content="🎮 ИГРАТЬ"
                            Background="#FF6B6B"
                            Click="PlayButton_Click"/>

                    <Button Style="{StaticResource MenuButton}" 
                            Content="🏆 ДОСТИЖЕНИЯ"
                            Background="#4ECDC4"
                            Click="AchievementsButton_Click"/>

                    <Button Style="{StaticResource MenuButton}" 
                            Content="📊 РЕКОРДЫ"
                            Background="#45B7D1"
                            Click="LeaderboardButton_Click"/>

                    <Button Style="{StaticResource MenuButton}" 
                            Content="⚙️ НАСТРОЙКИ"
                            Background="#96CEB4"
                            Click="SettingsButton_Click"/>

                    <Button x:Name="AdminButton"
                            Style="{StaticResource MenuButton}" 
                            Content="👑 АДМИНИСТРИРОВАНИЕ"
                            Background="#FF6B6B"
                            Click="AdminButton_Click"
                            Visibility="Collapsed"/>

                    <!-- Разделитель -->
                    <Border Height="1" 
                            Background="White" 
                            Opacity="0.3"
                            Width="200"
                            Margin="0,20,0,10"/>

                    <!-- Кнопка выхода из аккаунта -->
                    <Button Style="{StaticResource MenuButton}" 
                            Content="🚪 ВЫЙТИ ИЗ АККАУНТА"
                            Background="#FF8C00"
                            Click="LogoutButton_Click"/>

                    <!-- Кнопка выхода из приложения -->
                    <Button Style="{StaticResource MenuButton}" 
                            Content="❌ ВЫХОД"
                            Background="#FF6B6B"
                            Margin="5,5,5,5"
                            Click="ExitButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>