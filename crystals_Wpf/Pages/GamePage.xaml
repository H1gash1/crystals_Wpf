<Page x:Class="crystals_Wpf.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style TargetType="Button" x:Key="GameButton">
            <Setter Property="Background" Value="#FF6B6B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF5252"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF3838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="PowerUpButton">
            <Setter Property="Background" Value="#4ECDC4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="Width" Value="74"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="10">
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Icon}" 
                                           FontSize="24" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" 
                                           FontSize="10" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Count}" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           Foreground="#FFD700"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45B7D1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3AA8B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для карточек информации -->
        <Style TargetType="Border" x:Key="InfoCard">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="#FF6B6B"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/crystals_Wpf;component/assets/bg.png" 
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Background="#40FFFFFF" 
                Margin="15"
                Padding="15"
                CornerRadius="20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Игровое поле -->
                <UniformGrid x:Name="GameBoard"
                             Rows="8"
                             Columns="8"
                             Width="540"
                             Height="540"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                <!-- Разделитель -->
                <Border Grid.Column="1" 
                        Width="1" 
                        Background="White" 
                        Opacity="0.8"
                        Margin="15,0"/>

                <!-- Информационная панель -->
                <StackPanel Grid.Column="2"
                            Margin="15,0,0,0"
                            VerticalAlignment="Top">

                    <!-- Заголовок -->
                    <Border Margin="0,0,0,20" Padding="15,12" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6B6B" Offset="0"/>
                                <GradientStop Color="#FF8E53" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="✨ SWEETS ✨" 
                                   FontSize="26" 
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Карточка игрока -->
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="🎮 ИГРОК" 
                                       FontSize="12" 
                                       Opacity="0.8"
                                       Foreground="#6b6bff"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                            <TextBlock x:Name="PlayerText" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,10"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка очков -->
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="⭐ ОЧКИ" 
                                       FontSize="12" 
                                       Opacity="0.8"
                                       Foreground="#6b6bff"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                            <TextBlock x:Name="ScoreText" 
                                       Text="0"
                                       FontSize="38" 
                                       FontWeight="Bold"
                                       Foreground="white"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,10"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка ходов -->
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="🎯 ХОДЫ" 
                                       FontSize="12" 
                                       Opacity="0.8"
                                       Foreground="#6b6bff"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                            <TextBlock x:Name="MovesText" 
                                       Text="30"
                                       FontSize="38" 
                                       FontWeight="Bold"
                                       Foreground="white"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,10"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка усилителей -->
                    <Border Style="{StaticResource InfoCard}" Background="#2C3E50">
                        <StackPanel>
                            <TextBlock Text="💪 УСИЛИТЕЛИ" 
                   FontSize="14" 
                   Opacity="0.9"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,5"/>

                            <WrapPanel HorizontalAlignment="Center" Margin="5,0,5,10">
                                <!-- Бомба -->
                                <StackPanel Margin="3">
                                    <Button x:Name="PowerUpBomb" 
                        Width="65" Height="55"
                        Background="#4ECDC4"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="💣" FontSize="28" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Бомба" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock x:Name="BombCount" 
                           Text="2" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="#FFD700" 
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Ракета -->
                                <StackPanel Margin="3">
                                    <Button x:Name="PowerUpRocket" 
                        Width="65" Height="55"
                        Background="#4ECDC4"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="🚀" FontSize="28" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Ракета" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock x:Name="RocketCount" 
                           Text="2" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="#FFD700" 
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Радуга -->
                                <StackPanel Margin="3">
                                    <Button x:Name="PowerUpRainbow" 
                        Width="65" Height="55"
                        Background="#4ECDC4"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="🌈" FontSize="28" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Радуга" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock x:Name="RainbowCount" 
                           Text="2" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="#FFD700" 
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Кнопка назад -->
                    <Button Style="{StaticResource GameButton}"
                            Content="← НАЗАД"
                            Margin="0,10,0,0"
                            Click="BackButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>