<Page x:Class="crystals_Wpf.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/crystals_Wpf;component/assets/bg.png" 
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Background="#80FFFFFF" Margin="20" CornerRadius="20">
            <Border Width="450" Height="580" Background="#E6FFFFFF" CornerRadius="15" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel Margin="30">

                    <Border Margin="0,0,0,25" Padding="20,12" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6B6B" Offset="0"/>
                                <GradientStop Color="#FF8E53" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="📝 РЕГИСТРАЦИЯ" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ЛОГИН" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="0,10,0,5"/>
                    <TextBox x:Name="LoginTextBox" 
                             Height="45" 
                             Margin="0,0,0,15"
                             Background="#F0F0F0"
                             Foreground="#333333"
                             BorderBrush="#4ECDC4"
                             BorderThickness="2"
                             Padding="10"
                             FontSize="14"/>

                    <TextBlock Text="ПАРОЛЬ" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="0,10,0,5"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Height="45" 
                                 Margin="0,0,0,15"
                                 Background="#F0F0F0"
                                 Foreground="#333333"
                                 BorderBrush="#4ECDC4"
                                 BorderThickness="2"
                                 Padding="10"
                                 FontSize="14"/>

                 

                    <Button Content="✅ ЗАРЕГИСТРИРОВАТЬСЯ" 
                            Height="45"
                            Background="#4ECDC4"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="RegisterButton_Click"/>

                    <Button Content="← НАЗАД" 
                            Height="40"
                            Margin="0,10,0,0"
                            Background="Transparent"
                            Foreground="#4ECDC4"
                            FontSize="14"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BackButton_Click"/>

                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>