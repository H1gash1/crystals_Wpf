<Page x:Class="crystals_Wpf.Pages.LeaderboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#4ECDC4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="RowBackground" Value="#F5F5F5"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFFFF"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4ECDC4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="35"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/crystals_Wpf;component/assets/bg.png" 
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Background="#80FFFFFF" Margin="20" CornerRadius="20">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Margin="0,0,0,20" Padding="20,12" CornerRadius="10" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF6B6B" Offset="0"/>
                            <GradientStop Color="#FF8E53" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🏆 ТАБЛИЦА РЕКОРДОВ 🏆" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <!-- Таблица -->
                <DataGrid x:Name="RecordsGrid"
                          Grid.Row="1"
                          IsReadOnly="True"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="🏅 МЕСТО" Binding="{Binding Place}" Width="100"/>
                        <DataGridTextColumn Header="👤 ИГРОК" Binding="{Binding Login}" Width="200"/>
                        <DataGridTextColumn Header="⭐ ОЧКИ" Binding="{Binding BestScore}" Width="150"/>
                        <DataGridTextColumn Header="📅 ДАТА" Binding="{Binding RecordDate}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Кнопка назад -->
                <Button Grid.Row="2"
                        Content="← НАЗАД"
                        Width="150"
                        Height="40"
                        Margin="0,20,0,0"
                        Background="#FF6B6B"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BackButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>